#!/bin/bash
# Post-merge hook: runs after git pull/merge
# Transforms @HOME@ placeholders to actual home directory paths

set -e

CONFIG_FILE="$(git rev-parse --show-toplevel)/config.toml"
HOME_DIR="$HOME"

# Check if config file exists and contains @HOME@ placeholders
if [ -f "$CONFIG_FILE" ] && grep -q '@HOME@' "$CONFIG_FILE" 2>/dev/null; then
    echo "Transforming @HOME@ placeholders to $HOME_DIR..."
    sed -i.bak "s|@HOME@|$HOME_DIR|g" "$CONFIG_FILE"
    rm -f "$CONFIG_FILE.bak"
    echo "✓ Paths updated for this machine"
fi
